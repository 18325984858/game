<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal|center_vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/sample_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DobbyProject"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- ───────── KernelPatch Superkey 状态 ─────────
         打开 App 时：如果 /data/local/tmp/.kp_key 里的 key 能通过 sc_hello，
         整块隐藏；否则显示输入框让用户填入 key。-->
    <LinearLayout
        android:id="@+id/layout_kpkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#33FF9800"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_kpkey_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ 需要 KernelPatch Superkey\n请在下方输入 APatch 的 Super Key，用于激活 inject-hide 隐身功能。"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_kpkey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入 Super Key"
            android:inputType="textPassword"
            android:maxLength="64"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"
            android:paddingEnd="44dp"
            android:layout_marginBottom="8dp" />

        <ImageButton
            android:id="@+id/btn_kpkey_show"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="-48dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_eye_off"
            android:contentDescription="show/hide" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_kpkey_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="验证并保存" />
        </LinearLayout>
    </LinearLayout>

    <!-- 设置宽容模式 -->
    <Button
        android:id="@+id/btn_selinux"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="① 设置宽容模式"
        android:layout_marginBottom="8dp" />

    <!-- 修改输入设备权限 -->
    <Button
        android:id="@+id/btn_input_perm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="② 修改输入设备权限"
        android:layout_marginBottom="8dp" />

    <!-- 部署中文字体 -->
    <Button
        android:id="@+id/btn_deploy_font"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="③ 部署中文字体"
        android:layout_marginBottom="16dp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="16dp" />

    <!-- 全局日志开关 -->
    <CheckBox
        android:id="@+id/cb_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用日志输出"
        android:checked="true"
        android:layout_marginBottom="12dp" />

    <!-- 可折叠区域: lol手游 -->
    <LinearLayout
        android:id="@+id/section_lol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_section_lol_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ lol手游"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

        <LinearLayout
            android:id="@+id/layout_lol_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <!-- 可选: il2cppDumper / il2cppHeader -->
            <CheckBox
                android:id="@+id/cb_dumper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 il2cppDumper (导出 dump)"
                android:checked="false"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 il2cppHeaderDumper (导出头文件)"
                android:checked="false"
                android:layout_marginBottom="8dp" />

            <!-- 启动游戏 -->
            <Button
                android:id="@+id/btn_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动游戏" />

        </LinearLayout>

    </LinearLayout>

    <!-- 可折叠区域: 和平精英 -->
    <LinearLayout
        android:id="@+id/section_pubg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_section_pubg_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ 和平精英"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

        <LinearLayout
            android:id="@+id/layout_pubg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <CheckBox
                android:id="@+id/cb_pubg_dumper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 ueDumper (导出 dump)"
                android:checked="false"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_pubg_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 ueHeader (导出头文件)"
                android:checked="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_pubg_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动游戏" />

        </LinearLayout>

    </LinearLayout>

    <!-- 可折叠区域: 三角洲 -->
    <LinearLayout
        android:id="@+id/section_dfm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_section_dfm_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ 三角洲"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

        <LinearLayout
            android:id="@+id/layout_dfm_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <CheckBox
                android:id="@+id/cb_dfm_dumper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 ueDumper (导出 dump)"
                android:checked="false"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_dfm_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 ueHeader (导出头文件)"
                android:checked="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_dfm_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动游戏" />

        </LinearLayout>

    </LinearLayout>

    <!-- 可折叠区域: 洛克王国手游 (NRC) -->
    <LinearLayout
        android:id="@+id/section_nrc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_section_nrc_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ 洛克王国手游"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

        <LinearLayout
            android:id="@+id/layout_nrc_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <CheckBox
                android:id="@+id/cb_nrc_dumper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 ueDumper (导出 dump)"
                android:checked="false"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_nrc_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 ueHeader (尚未适配)"
                android:enabled="false"
                android:checked="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_nrc_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动游戏" />

        </LinearLayout>

    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="16dp" />

    <!-- SO Dumper 入口 -->
    <Button
        android:id="@+id/btn_so_dumper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦 SO Dumper (Dump + ELF修复)"
        android:layout_marginBottom="8dp" />

    <!-- Memory Reader 入口 -->
    <Button
        android:id="@+id/btn_mem_reader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 内存读取器 (任意进程)"
        android:layout_marginBottom="8dp" />

    <!-- Inject-Hide 管理入口 -->
    <Button
        android:id="@+id/btn_inject_hide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛡️ Inject-Hide 管理 (KPM)"
        android:layout_marginBottom="16dp" />

    <!-- 状态显示 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="就绪"
        android:textSize="13sp"
        android:textColor="#666666"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
</ScrollView>